<h1>Products</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Brand</th>
      <th>Inventory Tracking Events</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= product.brand&.name %></td>
        <td><%= @inventory_event_counts.fetch(product.id, 0) %></td>
        <td><%= link_to "View", product_path(product) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%== pagy_nav(@pagy) if @pagy.pages > 1 %>

<nav>
  <%= link_to "Brands", brands_path %> |
  <%= link_to "Stores", stores_path %>
</nav>
