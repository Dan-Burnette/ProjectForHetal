<h1><%= @product.name %></h1>

<p>
  <strong>Brand:</strong>
  <% if @product.brand %>
    <%= link_to @product.brand.name, brand_path(@product.brand) %>
  <% else %>
    None
  <% end %>
</p>

<p>
  <strong>Total Inventory Tracking Events:</strong>
  <%= @pagy.count %>
</p>

<h2>Inventory Tracking Events</h2>
<table>
  <thead>
    <tr>
      <th>Event Time</th>
      <th>Inventory Present?</th>
      <th>Store Address</th>
    </tr>
  </thead>
  <tbody>
    <% @inventory_tracking_events.each do |event| %>
      <tr>
        <td><%= event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= event.inventory_present ? "Yes" : "No" %></td>
        <td><%= event.store&.address %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%== pagy_nav(@pagy) if @pagy.pages > 1 %>

<nav>
  <%= link_to "Back to Products", products_path %> |
  <%= link_to "Brands", brands_path %> |
  <%= link_to "Stores", stores_path %>
</nav>
