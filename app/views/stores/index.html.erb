<h1>Stores</h1>

<table>
  <thead>
    <tr>
      <th>Address</th>
      <th>Inventory Tracking Events</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @stores.each do |store| %>
      <tr>
        <td><%= store.address %></td>
        <td><%= @inventory_event_counts.fetch(store.id, 0) %></td>
        <td><%= link_to "View", store_path(store) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%== pagy_nav(@pagy) if @pagy.pages > 1 %>

<nav>
  <%= link_to "Products", products_path %> |
  <%= link_to "Brands", brands_path %>
</nav>
