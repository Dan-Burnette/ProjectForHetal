<h1><%= @brand.name %></h1>

<p>
  <strong>Total Products:</strong>
  <%= @products.size %>
</p>

<h2>Products</h2>
<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Inventory Tracking Events</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= @inventory_event_counts.fetch(product.id, 0) %></td>
        <td><%= link_to "View Product", product_path(product) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<nav>
  <%= link_to "Back to Brands", brands_path %> |
  <%= link_to "Products", products_path %> |
  <%= link_to "Stores", stores_path %>
</nav>
